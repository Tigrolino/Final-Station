{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "minecraft:custom_name",
    "cases": [
      {
        "when": "Forest Staff",
        "model": {
          "type": "minecraft:model",
          "model": "item/foreststaff"
        }
      },
      {
        "when": "Bread Staff",
        "model": {
          "type": "minecraft:model",
          "model": "item/breadstaff"
        }
      },
      {
        "when": "Void Staff",
        "model": {
          "type": "minecraft:model",
          "model": "item/voidstaff"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/stick"
    }
  }
}
